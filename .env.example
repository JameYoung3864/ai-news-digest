# ============================================================
#  AI News Digest - 环境变量模板
#  用法: 复制为 .env 后填写。所有密钥只在后端进程内使用，
#        永远不会下发到浏览器。
# ============================================================

# ---------- 服务端口 ----------
PORT=3000
HOST=127.0.0.1

# ---------- 新闻源选择 ----------
# rss     : 聚合多个公开 RSS(AI 媒体/实验室官方博客) —— 默认，免密钥
# gnews   : GNews API(需 GNEWS_API_KEY)，支持真正的关键词全网搜索
# newsapi : NewsAPI.org(需 NEWSAPI_API_KEY)
# auto    : 有 GNews key 用 GNews，否则回退 rss
NEWS_PROVIDER=rss

# ---------- 新闻 API 密钥(可选) ----------
# https://gnews.io  —— 免费额度 100 次/天
GNEWS_API_KEY=
# https://newsapi.org —— 免费额度 100 次/天(开发者版仅限 localhost)
NEWSAPI_API_KEY=

# ---------- DeepSeek AI ----------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 无 API Key 时把 AI_MOCK 设为 1，可跑通全流程(返回占位总结，不产生费用)
AI_MOCK=0

# ---------- 抓取行为 ----------
# 单个上游请求超时(毫秒)
REQUEST_TIMEOUT_MS=12000
# 重试次数(不含首次请求)
REQUEST_RETRY=1
# 单个 RSS 源超时(毫秒)
FEED_TIMEOUT_MS=10000
# 整轮聚合的硬预算(毫秒)：到点就用已抓到的部分返回
FEED_BUDGET_MS=18000
# 新闻列表缓存 TTL(毫秒) —— 保护上游配额
NEWS_CACHE_TTL_MS=300000
# 单个源最多保留多少条(官方博客 RSS 常含多年历史)
MAX_ITEMS_PER_SOURCE=40
# 超过多少天的新闻不进聚合池
MAX_ARTICLE_AGE_DAYS=180
# AI 总结缓存 TTL(毫秒) —— 同一条新闻只花一次 token
AI_CACHE_TTL_MS=86400000
# 抓取正文用于总结(true/false)：best-effort，失败自动回退到 RSS 摘要
ENABLE_ARTICLE_EXTRACT=1

# ---------- 限流(按 IP) ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=15
